{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "oxidized",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": [
                "gui",
                "fixed",
                "ground"
              ],
              "model": {
                "type": "minecraft:model",
                "model": "spindle:item/copper_shotgun/oxidized"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:select",
            "property": "minecraft:custom_model_data",
            "index": 1,
            "cases": [
              {
                "when": "reload",
                "model": {
                  "type": "minecraft:model",
                  "model": "spindle:item/copper_shotgun/oxidized_3d_open"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "spindle:item/copper_shotgun/oxidized_3d"
            }
          }
        }
      },
      {
        "when": "weathered",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": [
                "gui",
                "fixed",
                "ground"
              ],
              "model": {
                "type": "minecraft:model",
                "model": "spindle:item/copper_shotgun/weathered"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:select",
            "property": "minecraft:custom_model_data",
            "index": 1,
            "cases": [
              {
                "when": "reload",
                "model": {
                  "type": "minecraft:model",
                  "model": "spindle:item/copper_shotgun/weathered_3d_open"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "spindle:item/copper_shotgun/weathered_3d"
            }
          }
        }
      },
      {
        "when": "exposed",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": [
                "gui",
                "fixed",
                "ground"
              ],
              "model": {
                "type": "minecraft:model",
                "model": "spindle:item/copper_shotgun/exposed"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:select",
            "property": "minecraft:custom_model_data",
            "index": 1,
            "cases": [
              {
                "when": "reload",
                "model": {
                  "type": "minecraft:model",
                  "model": "spindle:item/copper_shotgun/exposed_3d_open"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "spindle:item/copper_shotgun/exposed_3d"
            }
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "gui",
            "fixed",
            "ground"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "spindle:item/copper_shotgun/normal"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:select",
        "property": "minecraft:custom_model_data",
        "index": 1,
        "cases": [
          {
            "when": "reload",
            "model": {
              "type": "minecraft:model",
              "model": "spindle:item/copper_shotgun/normal_3d_open"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "spindle:item/copper_shotgun/normal_3d"
        }
      }
    }
  }
}