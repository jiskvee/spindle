from camellia.utils import Location, technical

this = Location(~/)

#advancement technical(this.main) 
{
  "parent": "spindle:technical/root",
  "criteria": {
    "requirement": {
      "trigger": "minecraft:consume_item",
      "conditions": {
        "item": {
          "predicates": {
            "minecraft:custom_data": {
              "spindle": {
                "right_click": true
              }
            }
          }
        }
      }
    }
  },
  "rewards": {
    "function": this.main()
  }
}

function this.main:
	#advancement revoke @s only technical(this.main)
	execute if items entity @s weapon.mainhand *[custom_data~{spindle:{right_click:true}}] run return run function this.from_mainhand:
		item modify entity @s weapon.mainhand spindle:right_click/off
		item modify entity @s weapon.mainhand spindle:right_click/on

	execute if items entity @s weapon.offhand *[custom_data~{spindle:{right_click:true}}] run return run function this.from_offhand:
		item modify entity @s weapon.offhand spindle:right_click/off
		item modify entity @s weapon.offhand spindle:right_click/on
