from camellia.utils import technical

rc = ./rc
cd = ./cd
rc_adv = technical(rc)
cd_adv = technical(cd)

function rc:
	advancement revoke @s only rc_adv
	scoreboard players set @s spindle.step 1
	unless entity @s[tag=spindle.reloading] return run function ./reload/start
	function ./reload_tick

advancement rc_adv {
	"parent": f"{ctx.project_name}:technical/root",
	"criteria": {
		"requirement": {
			"trigger": "minecraft:using_item",
			"conditions": {
				"item": {
					"predicates": {
						"minecraft:custom_data": {
							"spindle": {
								"id": "copper_shotgun"
							}
						}
					}
				}
			}
		}
	},
	"rewards": {
		"function": rc
	}
}
