from camellia.utils import cit

function ./reload/check_ammo:
	if entity @s[gamemode=creative] run return 1
	if items entity @s inventory.* *[custom_data~{spindle:{id:"copper_shell"}}] run return 1
	if items entity @s hotbar.* *[custom_data~{spindle:{id:"copper_shell"}}] run return 1
	if items entity @s weapon.offhand *[custom_data~{spindle:{id:"copper_shell"}}] run return 1

function ./reload/start:
	# no ammo in inventory
	unless function ./reload/check_ammo run return run function ./reload/no_ammo:
		if entity @s[tag=spindle.ammoless] run return fail
		title @s actionbar [{text:"\u2718\u23f5 ",color:"red"},{translate:"item.spindle.copper_shotgun.message.no_ammo",with:[{translate:"item.spindle.copper_shell",color:"red"}],color:"#ffbbbb"}]
		playsound spindle:item.copper_shotgun.empty player "@c" ~ ~ ~ 0.4 1
		tag @s add spindle.ammoless

	# get stats from item
	execute run function ./reload/get_stats:
		if items entity @s weapon.offhand cit("spindle","copper_shotgun") run return run data modify storage spindle:temp root.stats set from entity @s equipment.offhand.components."minecraft:custom_data".spindle.gun
		data modify storage spindle:temp root.stats set from entity @s SelectedItem.components."minecraft:custom_data".spindle.gun
	
	scoreboard players set @s spindle.shotgun.pos 1
	scoreboard players set @s spindle.shotgun.dir 1
	scoreboard players set @s spindle.shotgun.time 0
	store result score @s spindle.shotgun.spot run random value 3..8
	store result score @s spindle.shotgun.step run data get storage spindle:temp root.stats.reload_step
	store result score @s spindle.shotgun.state run data get storage spindle:temp root.stats.state
	data remove storage spindle:temp root

	# awesome
	tag @s add spindle.reloading
	playsound spindle:item.copper_shotgun.open player "@c" ~ ~ ~ 1 1
	function ./get_hand
	execute run function ./set_action/reload:
		if score $bool spindle.dummy matches 0 run return run
			item modify entity @s weapon.mainhand spindle:shotgun/action/reload
		if score $bool spindle.dummy matches 1 run return run
			item modify entity @s weapon.offhand spindle:shotgun/action/reload


function ./reload/bar/display:
	# base bar: 9 long, 0..8
	data remove storage spindle:shotgun root
	data merge storage spindle:shotgun {root:{bar:["E","E","E","E","E","E","E","E","E"]}}

	store result storage spindle:shotgun root.spot int 1 run scoreboard players get @s spindle.shotgun.spot
	#store result storage spindle:shotgun root.pos int 1 run scoreboard players get @s spindle.shotgun.pos

	# ----- FUTURE VISION WITCHCRAFT -----
    # copy current pos and time to temp scores
    scoreboard players operation @s spindle.shotgun.display_pos = @s spindle.shotgun.pos
    scoreboard players operation @s spindle.shotgun.next_time = @s spindle.shotgun.time
    
    # simulate what the time will be next tick
    scoreboard players add @s spindle.shotgun.next_time 1
    
    # if the bullet will move next tick, apply the movement to the display position NOW
    if score @s spindle.shotgun.next_time >= @s spindle.shotgun.step:
		scoreboard players operation @s spindle.shotgun.display_pos += @s spindle.shotgun.dir
    
    # pass the future display_pos to the storage instead of the actual pos
    store result storage spindle:shotgun root.pos int 1 run scoreboard players get @s spindle.shotgun.display_pos
    # ------------------------------------

	# get oxidization state for the font
	execute run function ./reload/bar/state:
		if score @s spindle.shotgun.state matches 0 run return run data modify storage spindle:shotgun root.state set value "normal"
		if score @s spindle.shotgun.state matches 1 run return run data modify storage spindle:shotgun root.state set value "exposed"
		if score @s spindle.shotgun.state matches 2 run return run data modify storage spindle:shotgun root.state set value "weathered"
		data modify storage spindle:shotgun root.state set value "oxidized"

	# place bullet and hole
	execute run function ./reload/bar/place_spot with storage spindle:shotgun root:
		$data modify storage spindle:shotgun root.bar[$(spot)] set value "O"

	execute run function ./reload/bar/place_cartridge with storage spindle:shotgun root:
		$data modify storage spindle:shotgun root.bar[$(pos)] set value "B"

	# parse array into a string
	data modify storage spindle:shotgun root.parsed set value ""
	execute run function ./reload/bar/parse:
		# copy last element and remove it
		data modify storage spindle:shotgun root.current set from storage spindle:shotgun root.bar[-1]
		execute run function ./reload/bar/concat with storage spindle:shotgun root:
			$data modify storage spindle:shotgun root.parsed set value "$(current) $(parsed)"
		data remove storage spindle:shotgun root.bar[-1]

		# loop if there are still elements left
		if data storage spindle:shotgun root.bar[-1] run return run function ./reload/bar/parse

	# finally show bar
	execute run function ./reload/bar/show with storage spindle:shotgun root:
		$title @s actionbar {text:"( $(parsed))",font:"spindle:reload_bar/$(state)"}


function ./reload/end:
	tag @s remove spindle.reloading
	function ./get_hand
	execute run function ./set_action/ready:
		if score $bool spindle.dummy matches 0 run return run
			item modify entity @s weapon.mainhand spindle:shotgun/action/ready
		if score $bool spindle.dummy matches 1 run return run
			item modify entity @s weapon.offhand spindle:shotgun/action/ready
	function ./reload/determine
	data remove storage spindle:shotgun root


function ./reload/determine:
	if score @s spindle.shotgun.pos = @s spindle.shotgun.spot run return run function ./reload/success:
		clear @s[gamemode=!creative] cit("spindle","copper_shell") 1
		playsound spindle:item.copper_shotgun.rack player "@c" ~ ~ ~ 1 1
		playsound spindle:item.copper_shotgun.reload_success player @s ~ ~ ~ 0.5 1

		function ./reload/bar/display
		execute run function ./reload/bar/show_green with storage spindle:shotgun root:
			$title @s actionbar {text:"( $(parsed))",font:"spindle:reload_bar/$(state)",color:"green"}

		execute run function ./ammo/load:
			if score $bool spindle.dummy matches 0 run return run
				item modify entity @s weapon.mainhand spindle:shotgun/ammo/load
			if score $bool spindle.dummy matches 1 run return run
				item modify entity @s weapon.offhand spindle:shotgun/ammo/load
	
	execute run function ./reload/fail:
		playsound spindle:item.copper_shotgun.close player "@c" ~ ~ ~ 0.8 1
		playsound spindle:item.copper_shotgun.reload_fail player @s ~ ~ ~ 0.4 1

		function ./reload/bar/display
		execute run function ./reload/bar/show_red with storage spindle:shotgun root:
			$title @s actionbar {text:"( $(parsed))",font:"spindle:reload_bar/$(state)",color:"red"}