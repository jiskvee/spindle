from spindle:utils import modify_weapon
from camellia.utils import technical, cit


function ./tick:
	if score @s spindle.step matches 1.. run return run scoreboard players remove @s spindle.step 1
	if entity @s[tag=spindle.reloading] run function ./reload/end
	scoreboard players reset @s spindle.step
	tag @s remove spindle.ammoless


rc = ./rc
rc_adv = technical(rc)

function rc:
	advancement revoke @s only rc_adv
	scoreboard players set @s spindle.step 1
	if entity @s[tag=!spindle.reloading] run return run function ./reload/start
	function ./reload_tick

function ./reload_tick:
	scoreboard players add @s spindle.shotgun.time 1
	execute if score @s spindle.shotgun.time >= @s spindle.shotgun.step run function ./reload/bar/move:
		scoreboard players set @s spindle.shotgun.time 0
		scoreboard players operation @s spindle.shotgun.pos += @s spindle.shotgun.dir
		execute if score @s spindle.shotgun.pos matches 8.. run
			scoreboard players operation @s spindle.shotgun.dir *= -1 spindle.shotgun.dir
		execute if score @s spindle.shotgun.pos matches ..0 run
			scoreboard players operation @s spindle.shotgun.dir *= -1 spindle.shotgun.dir
	function ./reload/bar/display


function ./shoot:
	advancement revoke @s only shoot_adv
	modify_weapon('copper_shotgun', 'spindle:shotgun/ammo/unload')

	rotate @s ~ ~-5
	playsound spindle:item.copper_shotgun.shoot player "@c" ~ ~ ~ 0.6 1
	execute anchored eyes positioned ^ ^ ^0.8 run particle large_smoke ~ ~ ~ 0 0 0 0.03 3
	execute anchored eyes positioned ^ ^ ^0.7 run particle electric_spark ~ ~ ~ 0.1 0.1 0.1 0.03 5

	execute run function ./oxidize:
		execute if items entity @s weapon.mainhand cit("spindle","copper_shotgun") run return run
			item modify entity @s weapon.mainhand spindle:shotgun/oxidize
		execute if items entity @s weapon.offhand cit("spindle","copper_shotgun") run return run
			item modify entity @s weapon.mainhand spindle:shotgun/oxidize

	function ./raycast/start


advancement rc_adv {
  "parent": "spindle:technical/root",
  "criteria": {
    "requirement": {
      "trigger": "minecraft:using_item",
      "conditions": {
        "item": {
          "predicates": {
            "minecraft:custom_data": {
              "spindle": {
                "id": "copper_shotgun"
              }
            }
          }
        }
      }
    }
  },
  "rewards": {
    "function": rc
  }
}
