from camellia.utils import cit
from spindle:utils import modify_weapon

function ./as_arrow:
	stopsound "@c" player minecraft:item.crossbow.shoot
	execute on origin at @s run function ./use
	kill @s


function ./use:
	execute if items entity @s weapon.* *[minecraft:damage=199,minecraft:custom_data~{spindle:{id:"copper_shotgun"}}] run tag @s add spindle.broken_gun
	modify_weapon('copper_shotgun', 'spindle:shotgun/arrow_reset', '@s[tag=!spindle.broken_gun]')
	execute if items entity @s weapon.* *[minecraft:custom_data~{spindle:{gun:{loaded:true}}}] run return run function ./shoot
	function ./reload/start


def oxide_switch(slot:str):
	execute if score @s spindle.dummy matches 150.. run return run item modify entity @s slot spindle:shotgun/state/oxidized
	execute if score @s spindle.dummy matches 100.. run return run item modify entity @s slot spindle:shotgun/state/weathered
	execute if score @s spindle.dummy matches 50.. run return run item modify entity @s slot spindle:shotgun/state/exposed
	execute if score @s spindle.dummy matches 0.. run return run item modify entity @s slot spindle:shotgun/state/normal

function ./shoot:
	rotate @s ~ ~-5
	playsound spindle:item.copper_shotgun.shoot player "@c" ~ ~ ~ 0.6 1
	execute anchored eyes positioned ^ ^ ^0.8 run particle large_smoke ~ ~ ~ 0 0 0 0.03 3
	execute anchored eyes positioned ^ ^ ^0.7 run particle electric_spark ~ ~ ~ 0.1 0.1 0.1 0.03 5
	#execute anchored eyes positioned ^-0.25 ^ ^0.8 run particle small_flame ~ ~ ~ 0 0 0 0.02 2

	execute if entity @s[tag=!spindle.broken_gun] run function ./oxidize:
		execute if items entity @s weapon.mainhand *[minecraft:custom_data~{spindle:{id:"copper_shotgun"}}] run return run function ./oxidize_mainhand:
			execute store result score @s spindle.dummy run data get entity @s SelectedItem.components."minecraft:damage"
			oxide_switch('weapon.mainhand')
		
		execute if items entity @s weapon.offhand *[minecraft:custom_data~{spindle:{id:"copper_shotgun"}}] run return run function ./oxidize_offhand:
			execute store result score @s spindle.dummy run data get entity @s equipment.offhand.components."minecraft:damage"
			oxide_switch('weapon.offhand')

	modify_weapon('copper_shotgun', 'spindle:shotgun/ammo/unload', '@s[tag=!spindle.broken_gun]')
	function ./raycast/start
	tag @s remove spindle.broken_gun


function ./tick:
	execute unless entity @s[tag=spindle.reloading] run return fail

	scoreboard players add @s spindle.shotgun.time 1
	execute if score @s spindle.shotgun.time >= @s spindle.shotgun.step run function ./reload/bar/move:
		scoreboard players set @s spindle.shotgun.time 0
		scoreboard players operation @s spindle.shotgun.pos += @s spindle.shotgun.dir
		execute if score @s spindle.shotgun.pos matches 8.. run
			scoreboard players operation @s spindle.shotgun.dir *= -1 spindle.shotgun.dir
		execute if score @s spindle.shotgun.pos matches ..0 run
			scoreboard players operation @s spindle.shotgun.dir *= -1 spindle.shotgun.dir
	
	function ./reload/bar/display
