from camellia.utils import Location, technical
this = Location(./technical)
rc = Location(./technical/right_click)

function this.egg:
	scoreboard players reset @s spindle.egg
	tag @s add spindle.egg
	execute as @n[type=#spindle:pets,tag=!spindle.has_owner] run function spindle:entity/copper_pet/set_owner
	execute as @n[type=#spindle:copper_entities,tag=spindle.placed] at @s run function spindle:entity/copper_pet/placed
	tag @s remove spindle.egg

function rc.main:
	#advancement revoke @s only technical(this.right_click.main)
	execute if items entity @s weapon.mainhand *[custom_data~{spindle:{right_click:true}}] run return run function rc.from_mainhand:
		item modify entity @s weapon.mainhand spindle:right_click/off
		item modify entity @s weapon.mainhand spindle:right_click/on

	execute if items entity @s weapon.offhand *[custom_data~{spindle:{right_click:true}}] run return run function rc.from_offhand:
		item modify entity @s weapon.offhand spindle:right_click/off
		item modify entity @s weapon.offhand spindle:right_click/on


#advancement spindle:technical/right_click
{
  "parent": "spindle:technical/root",
  "criteria": {
    "requirement": {
      "trigger": "minecraft:consume_item",
      "conditions": {
        "item": {
          "predicates": {
            "minecraft:custom_data": {
              "spindle": {
                "right_click": true
              }
            }
          }
        }
      }
    }
  },
  "rewards": {
    "function": rc.main()
  }
}