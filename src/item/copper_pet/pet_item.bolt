"""
function ./raycast/start:
	tag @s add spindle.raycast
	scoreboard players set @s spindle.dummy 0
	execute store result score @s spindle.dummy run attribute @s minecraft:block_interaction_range get 100
	execute anchored eyes run function ./raycast/step

function ./raycast/step:
	scoreboard players remove @s spindle.dummy 1
	execute unless block ~ ~ ~ #spindle:pass_through positioned ^ ^ ^-0.01 align xyz positioned ~0.5 ~ ~0.5 run return run function ./deploy
	execute unless score @s spindle.dummy matches 1.. run return run scoreboard players set @s spindle.dummy 0
	execute positioned ^ ^ ^0.01 run function ./raycast/step

function ./deploy:
	scoreboard players set @s spindle.dummy 0

	data remove storage spindle:temp root
	data modify storage spindle:temp root.item set from entity @s SelectedItem.components
	data modify storage spindle:temp root.pet set from storage spindle:temp root.item."minecraft:custom_data".spindle.pet
	#data modify storage spindle:temp root.pet set from entity @s SelectedItem.components."minecraft:custom_data".spindle.pet

	execute if data storage spindle:temp root.item."minecraft:custom_name" run function ./custom_name:
		data modify storage spindle:temp root.pet.nbt.data.has_custom_name set value true
		data remove storage spindle:temp root.pet.nbt.Team
	data modify storage spindle:temp root.pet.nbt.CustomName set from storage spindle:temp root.item."minecraft:custom_name"

	tag @s add spindle.deploying
	function ./summon_macro with storage spindle:temp root.pet
	tag @s remove spindle.deploying

	playsound minecraft:block.copper_golem_statue.place neutral "@c"

	item modify entity @s[gamemode=!creative] weapon.mainhand spindle:count/remove_1
	data remove storage spindle:temp root

function ./summon_macro:
	# don't forget, ./ does not work in macros
	$execute summon $(type) run function spindle:item/copper_pet/data_macro with storage spindle:temp root.pet

function ./data_macro:
	$data merge entity @s $(nbt)
	data modify entity @s Owner set from entity @p[tag=spindle.deploying] UUID
	execute if entity @s[type=minecraft:wolf] run function ./as_wolf:	
		attribute @s minecraft:max_health base set 40
		execute unless data storage spindle:temp root.pet.nbt.sound_variant run data modify entity @s Health set value 40
"""