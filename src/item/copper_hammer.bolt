from spindle:utils import random_chance
from camellia.utils import Location, cit, technical

this = Location(~/)


function this.tick:
	if score @s spindle.hammer.cd matches 1.. run return run scoreboard players remove @s spindle.hammer.cd 1
	unless predicate spindle:item/hammer/lightning_strikable run return fail

	if items entity @s weapon.* *[minecraft:custom_data~{spindle:{charge:4b}}] positioned over motion_blocking run return run function this.tick_overcharge:
		if predicate spindle:tick/20 if predicate random_chance(0.4) run playsound spindle:item.copper_hammer.spark player "@c" ~ ~ ~ 0.5 2
		if predicate random_chance(0.002) run summon minecraft:lightning_bolt
		if predicate random_chance(0.2) run particle minecraft:electric_spark ~ ~0.1 ~ 0.2 0 0.2 0.1 2
		if predicate random_chance(0.2) run particle minecraft:electric_spark ~ ~ ~ 0 1 0 1 0

	positioned over motion_blocking run function this.conductive:
		if predicate random_chance(0.001) run summon minecraft:lightning_bolt
		if predicate random_chance(0.1) run particle minecraft:electric_spark ~ ~0.1 ~ 0.2 0 0.2 0.1 2
		if predicate random_chance(0.1) run particle minecraft:electric_spark ~ ~ ~ 0 1 0 1 0


function this.hit.as_victim:
	positioned over motion_blocking run summon minecraft:lightning_bolt
	positioned over motion_blocking unless entity @s[distance=..4.5] run return fail
	if predicate random_chance(0.33) run damage @s 6 spindle:lightning
	damage @s 6 spindle:lightning


function this.hit.as_victim_overcharge:
	positioned over motion_blocking run function this.lot_of_lightning:
		if entity @s[distance=..4.5] run damage @s 15 spindle:lightning
		summon minecraft:lightning_bolt
		summon minecraft:lightning_bolt
		summon minecraft:lightning_bolt


function this.hit.as_attacker:
	unless predicate spindle:item/hammer/strike run return fail
	scoreboard players set @s spindle.hammer.cd 30

	execute run function this.effects:
		if items entity @s weapon.mainhand *[minecraft:custom_data~{spindle:{charge:4b}}] run return run function this.hit.as_attacker_overcharge:
			playsound spindle:item.copper_hammer.erupt player "@c"
			playsound spindle:item.copper_hammer.erupt player "@c"
			damage @s 8 spindle:lightning
		playsound spindle:item.copper_hammer.discharge player "@c"

	execute run function this.remove_charge:
		if items entity @s weapon.mainhand cit("spindle","copper_hammer") run return run
			item modify entity @s weapon.mainhand spindle:hammer/remove_charge
		if items entity @s weapon.offhand cit("spindle","copper_hammer") run
			item modify entity @s weapon.offhand spindle:hammer/remove_charge


function this.struck:
	advancement revoke @s only technical(this.struck)
	if score @s spindle.hammer.cd matches 1.. run return fail
	scoreboard players set @s spindle.hammer.cd 30

	execute run function this.add_charge:
		if items entity @s weapon.mainhand cit("spindle","copper_hammer") run return run
			item modify entity @s weapon.mainhand spindle:hammer/add_charge
		if items entity @s weapon.offhand cit("spindle","copper_hammer") run
			item modify entity @s weapon.offhand spindle:hammer/add_charge

	if items entity @s weapon.* *[minecraft:custom_data~{spindle:{charge:4b}}] run return run function this.overcharge:
		playsound spindle:item.copper_hammer.overcharge player "@c"
		damage @s 8 spindle:lightning
	playsound spindle:item.copper_hammer.charge player "@c"


advancement technical(this.struck) {
  "parent": "spindle:technical/root",
  "criteria": {
    "requirement": {
      "trigger": "minecraft:entity_hurt_player",
      "conditions": {
        "player": [
          {
            "condition": "minecraft:reference",
            "name": "spindle:item/hammer/holding"
          },
          {
            "condition": "minecraft:inverted",
            "term": {
              "condition": "minecraft:entity_scores",
              "entity": "this",
              "scores": {
                "spindle.hammer.cd": {
                  "min": 1
                }
              }
            }
          }
        ],
        "damage": {
          "type": {
            "tags": [
              {
                "id": "minecraft:is_lightning",
                "expected": true
              }
            ]
          }
        }
      }
    }
  },
  "rewards": {
    "function": this.struck()
  }
}
