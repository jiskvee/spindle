from camellia.clocks import tick, second_clock, ten_second_clock
from camellia.utils import Location, technical
from spindle:utils import random_chance

this = Location(~/)

prepend function tick:
	as @a at @s run function this.tick:
		if score @s spindle.egg matches 1.. run function spindle:item/egg
		if predicate spindle:item/hammer/holding run function spindle:item/copper_hammer/tick
		if predicate spindle:item/shotgun/holding run function spindle:item/copper_shotgun/tick

prepend function ten_second_clock:
	as @a[predicate=spindle:location/under_thunder] at @s run function this.lightning_bolt_chance:
		if items entity @s spindle:inventory *[custom_data~{spindle:{charge:4b}}]
			if predicate random_chance(0.05) positioned over motion_blocking run summon minecraft:lightning_bolt

		store result score @s spindle.dummy if items entity @s armor.* #spindle:copper_armor
		if score @s spindle.dummy matches 1 if predicate random_chance(0.01) run return run execute positioned over motion_blocking run summon minecraft:lightning_bolt
		if score @s spindle.dummy matches 2 if predicate random_chance(0.02) run return run execute positioned over motion_blocking run summon minecraft:lightning_bolt
		if score @s spindle.dummy matches 3 if predicate random_chance(0.03) run return run execute positioned over motion_blocking run summon minecraft:lightning_bolt
		if score @s spindle.dummy matches 4 if predicate random_chance(0.04) run return run execute positioned over motion_blocking run summon minecraft:lightning_bolt

function this.clear_saddle:
	item replace entity @s saddle with air

function this.lightning_strike:
	advancement revoke @s only technical(this.lightning_strike)
	as @e[type=minecraft:cat,distance=..256,tag=spindle.copper_cat] at @s if entity @e[type=minecraft:lightning_bolt,distance=..4] run function ./copper_cat/lightning_strike
	as @e[type=minecraft:wolf,distance=..256,tag=spindle.copper_wolf] at @s if entity @e[type=minecraft:lightning_bolt,distance=..4] run function ./copper_wolf/lightning_strike
	as @e[type=minecraft:frog,distance=..256,tag=spindle.copper_frog] at @s if entity @e[type=minecraft:lightning_bolt,distance=..4] run function ./copper_frog/lightning_strike
	as @e[type=minecraft:skeleton_horse,distance=..256,tag=spindle.copper_horse] at @s if entity @e[type=minecraft:lightning_bolt,distance=..4] run function ./copper_horse/lightning_strike

advancement technical(this.lightning_strike) {
  "parent": "spindle:technical/root",
  "criteria": {
    "requirement": {
      "trigger": "minecraft:lightning_strike"
    }
  },
  "rewards": {
    "function": this.lightning_strike()
  }
}

slot_source spindle:inventory {
  "type": "minecraft:group",
  "terms": [
    {
      "type": "minecraft:slot_range",
      "slots": "inventory.*"
    },
    {
      "type": "minecraft:slot_range",
      "slots": "hotbar.*"
    }
  ]
}