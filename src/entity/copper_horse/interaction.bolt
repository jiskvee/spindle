"""
from spindle:advancements import attack_adv, interact_adv

function ./interaction/set_data:
	data merge entity @s {width:0.6,height:1.2,Tags:["smithed.entity","spindle.entity","spindle.copper_horse_interaction"]}
	ride @s mount @n[type=minecraft:skeleton_horse,tag=spindle.copper_horse]

function ./interaction/tick:
	execute unless predicate spindle:entity_properties/has_vehicle run return run kill @s
	execute on vehicle if predicate spindle:entity_properties/passenger/not_player on passengers run return run kill @s[type=minecraft:interaction,tag=spindle.copper_horse_interaction]

function ./interaction/left_click:
	playsound spindle:entity.copper_horse.neigh neutral "@c" ~ ~ ~ 1 1
	attack_adv("spindle.copper_horse_interaction")

function ./interaction/right_click:
	function ./raycast/start
	interact_adv("spindle.copper_horse_interaction")
"""