from camellia.clocks import tick, second_clock, ten_second_clock
from spindle:utils import random_chance

prepend function tick:
	execute as @e[type=minecraft:skeleton_horse,tag=spindle.copper_horse] at @s run function ./tick
prepend function second_clock:
	execute as @e[type=minecraft:skeleton_horse,tag=spindle.copper_horse] at @s run function ./second_clock

function spindle:commands/summon/copper_horse:
	summon minecraft:skeleton_horse ~ ~ ~ {Silent:1b,Tame:1b,CustomName:{translate:"entity.spindle.copper_horse"},DeathLootTable:"spindle:entities/copper_horse",Team:"spindle.no_nametag",Tags:["smithed.entity","spindle.entity","spindle.copper_horse"],equipment:{saddle:{id:"minecraft:saddle",count:1,components:{"minecraft:equippable":{slot:"saddle",asset_id:"spindle:copper_horse/default"},"minecraft:item_model":"spindle:gui/blocked_slot","minecraft:enchantment_glint_override":false,"minecraft:enchantments":{"minecraft:binding_curse":1},"minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{spindle:{id:"copper_horse"}}}}},drop_chances:{saddle:0.000},attributes:[{id:"minecraft:jump_strength",base:1.0},{id:"minecraft:max_health",base:30},{id:"minecraft:movement_speed",base:0.3375}]}

function ./tick:
	# laser
	execute on passengers at @s run function ./laser/tick

	# step sound
	execute if predicate spindle:entity_properties/is_on_ground if predicate spindle:entity_properties/has_passenger if predicate spindle:entity_properties/walking run function ./step:
		scoreboard players add @s spindle.step 1
		execute if score @s spindle.step matches 8.. run function ./step_sound:
			playsound minecraft:entity.horse.gallop neutral "@c" ~ ~ ~ 0.25
			scoreboard players reset @s spindle.step

	# hurt
	execute store result score @s spindle.hurt run data get entity @s HurtTime
	execute if score @s spindle.hurt matches 1.. if entity @s[tag=!spindle.ouch] run function ./hurt/start:
		tag @s add spindle.ouch
		raw item modify entity @s saddle spindle:entity/set_state/copper_horse/hurt
		playsound spindle:entity.copper_horse.hurt neutral "@c"
	execute if score @s spindle.hurt matches 0 if entity @s[tag=spindle.ouch] run function ./hurt/stop:
		tag @s remove spindle.ouch
		raw item modify entity @s saddle spindle:entity/set_state/copper_horse/default

function ./second_clock:
	# ambient sound
	scoreboard players add @s spindle.sound 1
	execute if predicate random_chance(0.5) run scoreboard players add @s spindle.sound 1
	execute if score @s spindle.sound matches 12.. run function ./ambient_sound:
		scoreboard players reset @s spindle.sound
		execute if predicate random_chance(0.01) run return run playsound spindle:entity.copper_horse.neigh neutral "@c" ~ ~ ~ 0.5
		playsound spindle:entity.copper_horse.ambient neutral "@c"

	# explosion
	execute unless predicate spindle:location_check/in_water run return run scoreboard players remove @s[scores={spindle.explode=1..}] spindle.explode 1
	execute if score @s spindle.explode matches 3 run function ./short_circuit
	execute if score @s spindle.explode matches 5 run function ./short_circuit
	execute if score @s spindle.explode matches 7.. run return run function ./explode
	scoreboard players add @s spindle.explode 1

function ./short_circuit:
	playsound spindle:entity.copper_mob.short_circuit neutral "@c"
	damage @s 0

function ./explode:
	data modify entity @s DeathTime set value 20
	playsound spindle:entity.copper_horse.death neutral "@c"
	item replace entity @s armor.feet with minecraft:poisonous_potato[equippable={slot:feet},enchantments={"spindle:technical/explosion":1}]

function ./mount:
	tag @s add spindle.show_instructions
	schedule function ./show_instructions 1t append:
		title @a[tag=spindle.show_instructions] actionbar {translate:"entity.spindle.copper_horse.instructions",with:[{keybind:"key.sprint"},{keybind:"key.sneak"}]}
		tag @a remove spindle.show_instructions
	#execute on vehicle at @s summon minecraft:interaction run function ./interaction/set_data
	advancement revoke @s only spindle:technical/entity/copper_horse/mount

advancement spindle:technical/entity/copper_horse/mount {
  "parent": "spindle:technical/root",
  "criteria": {
    "requirement": {
      "trigger": "minecraft:started_riding",
      "conditions": {
        "player": {
          "vehicle": {
            "minecraft:entity_type": "minecraft:skeleton_horse",
            "slots": {
              "saddle": {
                "items": "minecraft:saddle",
                "count": 1,
                "predicates": {
                  "minecraft:custom_data": {
                    "spindle": {
                      "id": "copper_horse"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "rewards": {
    "function": "spindle:entity/copper_horse/mount"
  }
}