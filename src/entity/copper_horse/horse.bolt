from camellia.clocks import tick, second_clock, ten_second_clock
from spindle:utils import random_chance

prepend function tick:
	as @e[type=minecraft:skeleton_horse,tag=spindle.copper_horse] at @s run function ./tick
prepend function second_clock:
	as @e[type=minecraft:skeleton_horse,tag=spindle.copper_horse] at @s run function ./second_clock

function spindle:commands/summon/copper_horse:
	summon minecraft:skeleton_horse ~ ~ ~ {Silent:1b,Tame:1b,CustomName:{translate:"entity.spindle.copper_horse"},DeathLootTable:"spindle:entities/copper_horse",Team:"spindle.no_nametag",Tags:["smithed.entity","spindle.entity","spindle.copper_horse"],equipment:{saddle:{id:"minecraft:saddle",count:1,components:{"minecraft:equippable":{slot:"saddle",asset_id:"spindle:copper_horse/default"},"minecraft:item_model":"spindle:gui/blocked_slot","minecraft:enchantment_glint_override":false,"minecraft:enchantments":{"minecraft:binding_curse":1},"minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{spindle:{id:"copper_horse"}}}}},drop_chances:{saddle:0.000},attributes:[{id:"minecraft:jump_strength",base:0.9},{id:"minecraft:max_health",base:30},{id:"minecraft:movement_speed",base:0.32}]}

function ./tick:
	# laser
	on passengers at @s run function ./laser/tick

	# step sound
	if predicate spindle:entity/is_on_ground if predicate spindle:entity/has_passenger if predicate spindle:entity/walking run function ./step:
		scoreboard players add @s spindle.step 1
		if score @s spindle.step matches 8.. run function ./step_sound:
			playsound minecraft:entity.horse.gallop neutral "@c" ~ ~ ~ 0.25
			scoreboard players reset @s spindle.step

	# hurt
	store result score @s spindle.hurt run data get entity @s HurtTime
	if score @s spindle.hurt matches 1.. if entity @s[tag=!spindle.ouch] run function ./hurt/start:
		tag @s add spindle.ouch
		item modify entity @s saddle spindle:entity/set_state/copper_horse/hurt
		playsound spindle:entity.copper_horse.hurt neutral "@c"
	if score @s spindle.hurt matches 0 if entity @s[tag=spindle.ouch] run function ./hurt/stop:
		tag @s remove spindle.ouch
		item modify entity @s saddle spindle:entity/set_state/copper_horse/no_hurt

function ./second_clock:
	# ambient sound
	scoreboard players add @s spindle.sound 1
	if predicate random_chance(0.5) run scoreboard players add @s spindle.sound 1
	if score @s spindle.sound matches 12.. run function ./ambient_sound:
		scoreboard players reset @s spindle.sound
		if predicate random_chance(0.01) run return run playsound spindle:entity.copper_horse.neigh neutral "@c" ~ ~ ~ 0.5
		playsound spindle:entity.copper_horse.ambient neutral "@c"

	# overcharged damage
	if entity @s[tag=spindle.overcharged] on passengers run function ./overcharged_clock:
		if predicate random_chance(0.25) run playsound spindle:item.copper_hammer.spark player "@c" ~ ~ ~ 0.5 2
		if predicate random_chance(0.1) run function ./damage_passenger:
			playsound spindle:item.copper_hammer.spark player "@c" ~ ~ ~ 1 2
			damage @s 3 spindle:electricity by @n[type=skeleton_horse,tag=spindle.copper_horse]

	# explosion
	unless predicate spindle:location/wet run return run scoreboard players remove @s[scores={spindle.explode=1..}] spindle.explode 1
	if score @s spindle.explode matches 3 run function ./short_circuit
	if score @s spindle.explode matches 5 run function ./short_circuit
	if score @s spindle.explode matches 7.. run return run function ./explode
	scoreboard players add @s spindle.explode 1

function ./overcharged_die:
	playsound spindle:entity.copper_horse.death neutral "@c"
	summon armor_stand ~ ~ ~ {Invisible:1b,equipment:{feet:{id:"poisonous_potato",components:{"enchantments":{"spindle:technical/explosion":1}}}}}

function ./short_circuit:
	playsound spindle:entity.copper_mob.short_circuit neutral "@c"
	damage @s 0

function ./explode:
	data modify entity @s DeathTime set value 20
	playsound spindle:entity.copper_horse.death neutral "@c"
	item replace entity @s armor.feet with poisonous_potato[equippable={slot:feet},enchantments={"spindle:technical/explosion":1}]

function ./lightning_strike:
	playsound spindle:item.copper_hammer.overcharge neutral "@c"
	item modify entity @s saddle spindle:entity/set_state/copper_horse/overcharged
	attribute @s minecraft:movement_speed base set 0.42
	attribute @s minecraft:max_health base set 16
	tag @s add spindle.overcharged
	damage @s 0

function ./mount:
	tag @s add spindle.show_instructions
	schedule function ./show_instructions 1t append:
		title @a[tag=spindle.show_instructions] actionbar {translate:"entity.spindle.copper_horse.instructions",with:[{keybind:"key.sprint"},{keybind:"key.sneak"}]}
		tag @a remove spindle.show_instructions
	advancement revoke @s only spindle:technical/entity/copper_horse/mount

advancement spindle:technical/entity/copper_horse/mount {
  "parent": "spindle:technical/root",
  "criteria": {
    "requirement": {
      "trigger": "minecraft:started_riding",
      "conditions": {
        "player": {
          "type": "minecraft:entity_properties",
          "entity": "this",
          "predicate": {
            "minecraft:vehicle": {
              "minecraft:entity_type": "minecraft:skeleton_horse",
              "minecraft:slots": {
                "saddle": {
                  "items": "minecraft:saddle",
                  "count": 1,
                  "predicates": {
                    "minecraft:custom_data": {
                      "spindle": {
                        "id": "copper_horse"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "rewards": {
    "function": "spindle:entity/copper_horse/mount"
  }
}