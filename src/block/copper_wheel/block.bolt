from spindle:advancements import attack_adv, interact_adv

function ./place/start:
	scoreboard players set $bool spindle.dummy 0
	execute positioned ~ ~0.5 ~ unless entity @n[type=minecraft:item_display,tag=smithed.block,distance=..0.99] run scoreboard players set $bool spindle.dummy 1
	execute if score $bool spindle.dummy matches 0 run function ./place/fail
	execute if score $bool spindle.dummy matches 1 run function ./place/success
	setblock ~ ~ ~ air

function ./place/fail:
	loot spawn ~ ~ ~ loot spindle:items/copper_wheel

function ./place/success:
	summon minecraft:interaction ~ ~ ~ {width:1.01f,height:0.51f,response:0b,Tags:["smithed.block","smithed.entity","smithed.strict","spindle.entity","spindle.copper_wheel_interaction"],Passengers:[{id:"minecraft:item_display",Tags:["smithed.block","smithed.entity","smithed.strict","spindle.block","spindle.copper_wheel"],item:{id:"minecraft:egg",components:{"minecraft:item_model":"spindle:block/copper_wheel"}}}]}
	playsound minecraft:block.copper.place block "@c"

function ./break/check:
	execute positioned ~ ~0.5 ~ unless block ~ ~ ~ #spindle:pass_through run function ./break/start

function ./break/start:
	playsound minecraft:block.copper.break block "@c"
	particle minecraft:item{item:{id:"minecraft:poisonous_potato",components:{"minecraft:item_model":"spindle:copper_wheel"}}} ~ ~ ~ 0.25 0.25 0.25 0.1 15
	loot spawn ~ ~ ~ loot spindle:items/copper_wheel

	execute on passengers run kill @s
	kill @s

function ./left_click:
	attack_adv("spindle.copper_wheel_interaction")
	execute as @n[type=minecraft:interaction,tag=spindle.copper_wheel_interaction,nbt={attack:{}}] at @s positioned ~ ~0.5 ~ run function ./break/start	
