function ./head/tick:
	execute if score @s spindle.wheel matches 200.. run return run function ./head/break_below:
		execute positioned ~0.3 ~-0.1 ~0.3 unless block ~ ~ ~ #spindle:indestructible run fill ~ ~ ~ ~ ~ ~ air destroy
		execute positioned ~-0.3 ~-0.1 ~0.3 unless block ~ ~ ~ #spindle:indestructible run fill ~ ~ ~ ~ ~ ~ air destroy
		execute positioned ~0.3 ~-0.1 ~-0.3 unless block ~ ~ ~ #spindle:indestructible run fill ~ ~ ~ ~ ~ ~ air destroy
		execute positioned ~-0.3 ~-0.1 ~-0.3 unless block ~ ~ ~ #spindle:indestructible run fill ~ ~ ~ ~ ~ ~ air destroy
		#fill ~0.3 ~-1 ~0.3 ~-0.3 ~-1 ~-0.3 air destroy
		scoreboard players reset @s spindle.wheel
	execute if predicate spindle:entity/is_on_ground run return run scoreboard players add @s spindle.wheel 1
	execute if score @s spindle.wheel matches 1.. run scoreboard players remove @s spindle.wheel 1

function ./head/location_changed:
	scoreboard players reset @s spindle.wheel
