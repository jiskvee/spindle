from camellia.utils import Location
this = Location(~/)

function this.start:
	advancement revoke @s only spindle:technical/placed_custom_block
	scoreboard players set @s spindle.dummy 0
	store result score @s spindle.dummy run attribute @s minecraft:block_interaction_range get 1
	scoreboard players add @s spindle.dummy 2
	anchored eyes run function this.raycast

function this.raycast:
	align xyz positioned ~0.5 ~0.5 ~0.5 run function this.scan
	scoreboard players remove @s spindle.dummy 1
	if score @s spindle.dummy matches 1.. positioned ^ ^ ^1 run function this.raycast

function this.scan:
	for y in range(-2, 3):
		positioned ~ ~y ~ run function this.layer

function this.layer:
	for x in range(-2, 3):
		for z in range(-2, 3):
			positioned ~x ~ ~z if block ~ ~ ~ #spindle:player_heads{components:{"minecraft:custom_data":{spindle:{}}}} run return run function this.end with block ~ ~ ~ components."minecraft:custom_data".spindle.block

function this.get_rotation:
	for i in range(0, 16):
		if block ~ ~ ~ player_head[rotation=i] run return run scoreboard players set #rotation spindle.dummy i
	if block ~ ~ ~ player_wall_head[facing=west] run return run scoreboard players set $rotation spindle.dummy 0
	if block ~ ~ ~ player_wall_head[facing=north] run return run scoreboard players set $rotation spindle.dummy 4
	if block ~ ~ ~ player_wall_head[facing=east] run return run scoreboard players set $rotation spindle.dummy 8
	if block ~ ~ ~ player_wall_head[facing=south] run return run scoreboard players set $rotation spindle.dummy 12

function this.end:
	scoreboard players set @s spindle.dummy 0
	function this.get_rotation
	data modify block ~ ~ ~ components."minecraft:profile" set value {texture:"spindle:blank"}
	$function $(place_function)
	if block ~ ~ ~ #spindle:player_heads run setblock ~ ~ ~ air

function this.cancel:
	$summon minecraft:item ~ ~ ~ {Item:{count:1,id:"minecraft:player_head",components:$(components)},PickupDelay:0}

advancement spindle:technical/placed_custom_block {
  "parent": "spindle:technical/root",
  "criteria": {
    "requirement": {
      "trigger": "minecraft:placed_block",
      "conditions": {
        "location": {
          "type": "minecraft:location_check",
          "predicate": {
            "block": {
              "blocks": "#spindle:player_heads",
              "predicates": {
                "minecraft:custom_data": {
                  "spindle": {}
                }
              }
            }
          }
        }
      }
    }
  },
  "rewards": {
    "function": this.start()
  }
}
